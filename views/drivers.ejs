<%- include('partials/header') %>

<div class="max-w-7xl mx-auto mt-8 px-4 sm:px-6 lg:px-8">

    <div class="sm:flex sm:items-center sm:justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                <i class="ph ph-steering-wheel text-blue-600"></i> <%= t.drivers_title %>
            </h1>
            <p class="mt-2 text-sm text-gray-700"><%= t.drivers_desc %></p>
        </div>

        <div class="mt-4 sm:mt-0 relative w-full sm:w-80">
            <div class="absolute inset-y-0 start-0 ps-3 flex items-center pointer-events-none">
                <i class="ph ph-magnifying-glass text-gray-400 text-lg"></i>
            </div>
            <input type="text" id="driverSearch" placeholder="<%= t.search_drivers %>"
                   class="block w-full ps-10 pe-3 py-2 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-all shadow-sm">
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden w-full">
        <div class="overflow-x-auto w-full">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-start text-xs font-bold text-gray-500 uppercase tracking-wider"><%= t.driver_details %></th>
                        <th class="px-6 py-3 text-start text-xs font-bold text-gray-500 uppercase tracking-wider"><%= t.role %></th>
                        <th class="px-6 py-3 text-start text-xs font-bold text-gray-500 uppercase tracking-wider"><%= t.driver_commission_label || 'Commission' %></th>
                        <th class="px-6 py-3 text-start text-xs font-bold text-gray-500 uppercase tracking-wider"><%= t.total_orders_handled %></th>
                        <th class="px-6 py-3 text-start text-xs font-bold text-gray-500 uppercase tracking-wider"><%= t.account_status %></th>
                        <th class="px-6 py-3 text-end text-xs font-bold text-gray-500 uppercase tracking-wider"><%= t.actions %></th>
                    </tr>
                </thead>
                <tbody id="driverTableBody" class="bg-white divide-y divide-gray-200">

                    <% if (drivers && drivers.length > 0) { %>
                        <% drivers.forEach(function(driver) { %>
                            <tr class="driver-row hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="flex-shrink-0 h-10 w-10 bg-orange-100 rounded-full flex items-center justify-center text-orange-600 font-bold">
                                            <%= driver.name.charAt(0).toUpperCase() %>
                                        </div>
                                        <div class="ms-4">
                                            <div class="text-sm font-medium text-gray-900 driver-name"><%= driver.name %></div>
                                            <div class="text-sm text-gray-500" dir="ltr">ID: DRV-<%= driver.id %></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-orange-100 text-orange-800">
                                        <%= t.driver %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium" dir="ltr">
                                    <%= Number(driver.default_commission || 0).toLocaleString() %> <%= t.currency %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium">
                                    <%= driver.total_orders %> <%= t.orders %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-1.5">
                                        <div class="w-2 h-2 rounded-full bg-green-500"></div>
                                        <span class="text-sm text-gray-700"><%= t.active %></span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
                                    <a href="/partners/<%= driver.id %>" class="text-blue-600 hover:text-blue-900 bg-blue-50 px-3 py-1.5 rounded-md hover:bg-blue-100 transition-colors"><%= t.view_payouts %></a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                                <i class="ph ph-steering-wheel text-4xl mb-2 text-gray-300"></i>
                                <p><%= t.no_drivers_found %></p>
                            </td>
                        </tr>
                    <% } %>

                </tbody>
            </table>
        </div>

        <div id="search-empty-state" class="hidden px-6 py-12 text-center text-gray-500">
            <i class="ph ph-magnifying-glass text-4xl mb-2 text-gray-300"></i>
            <p><%= t.no_drivers_match %></p>
        </div>
    </div>

</div>

<script>
    document.getElementById('driverSearch').addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        const rows = document.querySelectorAll('#driverTableBody tr.driver-row');
        let visibleCount = 0;
        rows.forEach(row => {
            const rowText = row.textContent.toLowerCase();
            if (rowText.includes(searchTerm)) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });
        const emptyState = document.getElementById('search-empty-state');
        if (visibleCount === 0 && rows.length > 0) {
            emptyState.classList.remove('hidden');
        } else {
            emptyState.classList.add('hidden');
        }
    });
</script>

<%- include('partials/footer') %>
