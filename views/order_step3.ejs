<%- include('partials/header') %>

<div class="max-w-3xl mx-auto mt-8 px-4 sm:px-6 lg:px-8">
    
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <i class="ph ph-users-three text-blue-600"></i> <%= t.assign_partners %>
        </h1>
        <p class="mt-2 text-sm text-gray-500 font-medium"><%= t.step_3_title %></p>
        
        <div class="w-full bg-gray-200 rounded-full h-2.5 mt-4">
            <div class="bg-blue-600 h-2.5 rounded-full" style="width: 75%"></div>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
        <form action="/orders/<%= orderID %>/merchant" method="POST" class="space-y-6">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="merchant_partner_id" class="block text-sm font-bold text-gray-700 mb-2"><%= t.merchant_sender %></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                            <i class="ph ph-storefront text-lg text-purple-500"></i>
                        </div>
                        <select id="merchant_partner_id" name="merchant_partner_id" required
                                class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-4 transition-all appearance-none">
                            <option value="" disabled selected><%= t.select_merchant %></option>
                            <% if (locals.merchants && merchants.length > 0) { %>
                                <% merchants.forEach(function(merchant) { %>
                                    <option value="<%= merchant.id %>"><%= merchant.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                </div>

                <div>
                    <label for="driver_partner_id" class="block text-sm font-bold text-gray-700 mb-2"><%= t.driver %></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                            <i class="ph ph-steering-wheel text-lg text-green-500"></i>
                        </div>
                        <select id="driver_partner_id" name="driver_partner_id" required
                                class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-4 transition-all appearance-none">
                            <option value="" disabled selected><%= t.select_driver %></option>
                            <% if (locals.drivers && drivers.length > 0) { %>
                                <% drivers.forEach(function(driver) { %>
                                    <option value="<%= driver.id %>"><%= driver.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-gray-100">
                <label for="company_partner_id" class="block text-sm font-bold text-gray-700 mb-2">
                    <%= t.company %> <span class="text-gray-400 font-normal"><%= t.company_optional %></span>
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                        <i class="ph ph-buildings text-lg text-indigo-500"></i>
                    </div>
                    <select id="company_partner_id" name="company_partner_id"
                            class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-4 transition-all appearance-none">
                        <option value=""><%= t.select_company %></option>
                        <% if (locals.companies && companies.length > 0) { %>
                            <% companies.forEach(function(company) { %>
                                <option value="<%= company.id %>"><%= company.name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
            </div>

            <div class="pt-4 border-t border-gray-100">
                <label for="shippment_id" class="block text-sm font-bold text-gray-700 mb-2"><%= t.shipment_manifest %></label>
                <div class="relative">
                    <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                        <i class="ph ph-package text-lg text-blue-500"></i>
                    </div>
                    <select id="shippment_id" name="shippment_id" required
                            class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-4 transition-all appearance-none">
                        <option value="" disabled selected><%= t.select_shipment %></option>
                        <% if (locals.shipments && shipments.length > 0) { %>
                            <% shipments.forEach(function(shipment) { %>
                                <option value="<%= shipment.id %>"><%= shipment.name || 'Shipment #' + shipment.id %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
            </div>

            <div class="pt-6 mt-6 border-t border-gray-100 flex justify-end">
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all flex items-center gap-2">
                    <%= t.next_commissions %> <i class="ph ph-arrow-right rtl:hidden"></i><i class="ph ph-arrow-left hidden rtl:block"></i>
                </button>
            </div>

        </form>
    </div>
</div>

<%- include('partials/footer') %>