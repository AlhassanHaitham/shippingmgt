<%- include('partials/header') %>

<div class="max-w-3xl mx-auto mt-8 px-4 sm:px-6 lg:px-8">

    <div class="mb-8">
        <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <i class="ph ph-map-pin-line text-blue-600"></i> <%= t.create_new_order %>
        </h1>
        <p class="mt-2 text-sm text-gray-500 font-medium"><%= t.step_2_title %></p>

        <div class="w-full bg-gray-200 rounded-full h-2.5 mt-4">
            <div class="bg-blue-600 h-2.5 rounded-full" style="width: 66%"></div>
        </div>
    </div>

    <div class="flex justify-end mb-3">
        <button type="button" onclick="document.getElementById('locationModal').classList.remove('hidden')"
                class="bg-white border border-gray-300 hover:border-blue-500 hover:text-blue-700 text-gray-700 font-medium py-2 px-4 rounded-lg shadow-sm transition-colors flex items-center gap-2 text-sm">
            <i class="ph ph-map-pin-plus"></i> Add New Location
        </button>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
        <form action="/orders/<%= orderID %>/location" method="POST" class="space-y-6">

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2"><%= t.from_location %></label>
                <div class="flex items-center gap-3 bg-gray-50 border border-gray-200 rounded-xl px-4 py-3">
                    <i class="ph ph-map-pin text-lg text-orange-500"></i>
                    <span class="text-gray-700 font-medium"><%= defaults.hqName %></span>
                </div>
                <p class="mt-1 text-xs text-gray-500">Auto-set to the parent company's address.</p>
            </div>

            <div>
                <label for="to_location_id" class="block text-sm font-bold text-gray-700 mb-2"><%= t.to_location %></label>
                <div class="relative">
                    <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                        <i class="ph ph-flag-checkered text-lg text-green-500"></i>
                    </div>
                    <select id="to_location_id" name="to_location_id" required
                            class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-4 transition-all appearance-none">
                        <option value="" disabled selected><%= t.select_location %></option>
                        <% if (locals.locations && locations.length > 0) { %>
                            <% locations.forEach(function(loc) { %>
                                <option value="<%= loc.id %>"><%= loc.name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
            </div>

            <div class="pt-4 border-t border-gray-100">
                <p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-3">Auto-assigned</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                    <div class="bg-purple-50 border border-purple-200 rounded-xl px-4 py-3 flex items-center gap-2">
                        <i class="ph ph-storefront text-purple-600"></i>
                        <span class="text-gray-800 font-medium">
                            <% if (locals.sender && sender.name) { %>
                                <%= sender.name %>
                            <% } else { %>
                                <%= t.no_sender_yet %>
                            <% } %>
                            <span class="text-gray-500 font-normal">(<%= t.sender %>)</span>
                        </span>
                    </div>
                    <div class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 flex items-center gap-2">
                        <i class="ph ph-hourglass-medium text-yellow-600"></i>
                        <span class="text-gray-700">Status: Pending</span>
                    </div>
                    <div class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 flex items-center gap-2 text-gray-500">
                        <i class="ph ph-steering-wheel"></i>
                        <span>Driver assigned later (commission auto-set to 5)</span>
                    </div>
                    <div class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 flex items-center gap-2 text-gray-500">
                        <i class="ph ph-package"></i>
                        <span>Shipment assigned later</span>
                    </div>
                </div>
            </div>

            <div class="pt-6 mt-6 border-t border-gray-100 flex justify-end">
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all flex items-center gap-2">
                    <%= t.next_commissions %> <i class="ph ph-arrow-right rtl:hidden"></i><i class="ph ph-arrow-left hidden rtl:block"></i>
                </button>
            </div>

        </form>
    </div>
</div>

<%- include('partials/add_location_modal', { returnPath: '/orders/' + orderID + '/location' }) %>

<%- include('partials/footer') %>
