<%- include('partials/header') %>

<div class="max-w-3xl mx-auto mt-8 px-4 sm:px-6 lg:px-8">

    <div class="mb-8">
        <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <i class="ph ph-storefront text-purple-600"></i> <%= t.create_new_order %>
        </h1>
        <p class="mt-2 text-sm text-gray-500 font-medium"><%= t.step_0_title %></p>

        <div class="w-full bg-gray-200 rounded-full h-2.5 mt-4">
            <div class="bg-blue-600 h-2.5 rounded-full" style="width: 12%"></div>
        </div>
    </div>

    <div class="flex justify-end mb-3">
        <button type="button" onclick="document.getElementById('merchantModal').classList.remove('hidden')"
                class="bg-white border border-gray-300 hover:border-purple-500 hover:text-purple-700 text-gray-700 font-medium py-2 px-4 rounded-lg shadow-sm transition-colors flex items-center gap-2 text-sm">
            <i class="ph ph-plus-circle"></i> <%= t.add_new_merchant %>
        </button>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
        <form action="/orders/new/sender" method="POST" class="space-y-6">

            <div>
                <label for="sender_partner_id" class="block text-sm font-bold text-gray-700 mb-2">
                    <%= t.pick_sender %>
                </label>
                <p class="text-xs text-gray-500 mb-3"><%= t.pick_sender_desc %></p>
                <div class="relative">
                    <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                        <i class="ph ph-storefront text-lg text-purple-500"></i>
                    </div>
                    <select id="sender_partner_id" name="sender_partner_id" required
                            class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-purple-500 focus:bg-white focus:ring-2 focus:ring-purple-200 text-gray-900 py-3 ps-10 pe-4 transition-all appearance-none">
                        <option value="" disabled <%= !locals.selectedSenderID ? 'selected' : '' %>><%= t.select_sender %></option>
                        <% if (locals.senders && senders.length > 0) { %>
                            <% senders.forEach(function(s) { %>
                                <option value="<%= s.id %>" <%= locals.selectedSenderID && Number(selectedSenderID) === Number(s.id) ? 'selected' : '' %>><%= s.name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <% if (!locals.senders || senders.length === 0) { %>
                    <p class="mt-2 text-xs text-orange-600"><i class="ph ph-warning"></i> No merchants yet — click "<%= t.add_new_merchant %>" to create one.</p>
                <% } %>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-end">
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all flex items-center gap-2">
                    <%= t.next_customer_details %> <i class="ph ph-arrow-right rtl:hidden"></i><i class="ph ph-arrow-left hidden rtl:block"></i>
                </button>
            </div>

        </form>
    </div>
</div>

<%- include('partials/add_merchant_modal', { returnPath: '/orders/new/sender' }) %>

<%- include('partials/footer') %>
