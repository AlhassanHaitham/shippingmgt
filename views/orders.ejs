<%- include('partials/header') %>

<div class="max-w-7xl mx-auto mt-8 px-4 sm:px-6 lg:px-8">

    <div class="sm:flex sm:items-center sm:justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                <i class="ph ph-package text-blue-600"></i> <%= t.all_orders %>
            </h1>
            <p class="mt-2 text-sm text-gray-700"><%= t.orders_desc %></p>
        </div>

        <div class="mt-4 sm:mt-0 relative w-full sm:w-auto flex flex-wrap items-center gap-3">
            <div class="relative w-full sm:w-64">
                <div class="absolute inset-y-0 start-0 ps-3 flex items-center pointer-events-none">
                    <i class="ph ph-magnifying-glass text-gray-400 text-lg"></i>
                </div>
                <input type="text" id="orderSearch" placeholder="<%= t.search_placeholder %>"
                       class="block w-full ps-10 pe-3 py-2 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-all shadow-sm">
            </div>
            <button type="button" id="assignShipmentBtn"
                    class="bg-white border border-blue-200 text-blue-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-50 transition-colors flex items-center gap-2 shadow-sm whitespace-nowrap">
                <i class="ph ph-package text-lg"></i> Assign Shipments
            </button>
            <button type="button" id="assignDriverBtn"
                    class="bg-white border border-orange-200 text-orange-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-orange-50 transition-colors flex items-center gap-2 shadow-sm whitespace-nowrap">
                <i class="ph ph-steering-wheel text-lg"></i> Assign Driver
            </button>
            <a href="/orders/new" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-700 transition-colors flex items-center gap-2 shadow-sm whitespace-nowrap">
                <i class="ph ph-plus-circle text-lg"></i> <%= t.new_order %>
            </a>
        </div>
    </div>

    <!-- Sticky select-mode bar (hidden by default) -->
    <div id="selectModeBar" class="hidden mb-4 rounded-xl border bg-white shadow-sm p-4 flex flex-col sm:flex-row sm:items-center gap-3 sticky top-2 z-30">
        <div class="flex items-center gap-2 text-sm font-bold">
            <span id="selectModeLabel" class="text-gray-700">Assigning…</span>
            <span class="text-gray-400">·</span>
            <span class="text-gray-600"><span id="selectedCount">0</span> selected</span>
        </div>

        <div id="shipmentPicker" class="hidden flex-1 min-w-0">
            <label class="block text-xs font-semibold text-gray-500 mb-1">Target shipment</label>
            <select id="shipmentSelect" class="block w-full sm:w-72 rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm">
                <option value="">Select a shipment...</option>
                <% (shipments || []).forEach(function(s){ %>
                    <option value="<%= s.id %>"><%= s.name %></option>
                <% }) %>
            </select>
        </div>

        <div id="driverPicker" class="hidden flex-1 min-w-0">
            <label class="block text-xs font-semibold text-gray-500 mb-1">Target driver</label>
            <select id="driverSelect" class="block w-full sm:w-72 rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm">
                <option value="">Select a driver...</option>
                <% (drivers || []).forEach(function(d){ %>
                    <option value="<%= d.id %>"><%= d.name %></option>
                <% }) %>
            </select>
        </div>

        <div class="flex items-center gap-2 sm:ms-auto">
            <button type="button" id="confirmAssignBtn" disabled
                    class="bg-blue-600 disabled:bg-gray-300 disabled:cursor-not-allowed text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-blue-700 transition-colors flex items-center gap-2">
                <i class="ph ph-check"></i> Confirm
            </button>
            <button type="button" id="cancelAssignBtn"
                    class="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-50 transition-colors">
                Cancel
            </button>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden w-full">
        <div class="overflow-x-auto w-full">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="select-col hidden px-3 py-3 text-start">
                            <input type="checkbox" id="selectAllBox" class="rounded border-gray-300">
                        </th>
                        <th scope="col" class="px-4 py-3 text-start text-xs font-bold text-gray-500 uppercase tracking-wider"><%= t.order_id || 'Order ID' %></th>
                        <th scope="col" class="px-4 py-3 text-start text-xs font-bold text-gray-500 uppercase tracking-wider"><%= t.receipt_no %></th>
                        <th scope="col" class="px-4 py-3 text-start text-xs font-bold text-gray-500 uppercase tracking-wider"><%= t.customer_phone %></th>
                        <th scope="col" class="px-4 py-3 text-start text-xs font-bold text-gray-500 uppercase tracking-wider"><%= t.merchant %></th>
                        <th scope="col" class="px-4 py-3 text-start text-xs font-bold text-gray-500 uppercase tracking-wider"><%= t.driver %></th>
                        <th scope="col" class="px-4 py-3 text-start text-xs font-bold text-gray-500 uppercase tracking-wider">Shipment</th>
                        <th scope="col" class="px-4 py-3 text-start text-xs font-bold text-gray-500 uppercase tracking-wider">Status</th>
                        <th scope="col" class="px-4 py-3 text-end text-xs font-bold text-gray-500 uppercase tracking-wider"><%= t.actions %></th>
                    </tr>
                </thead>
                <tbody id="orderTableBody" class="bg-white divide-y divide-gray-200">

                    <% if (orders && orders.length > 0) { %>
                        <% orders.forEach(function(order) {
                             const status = order.status || 'Pending';
                             const statusClass = {
                               Pending:   'bg-gray-100 text-gray-700 border-gray-200',
                               Delivered: 'bg-green-100 text-green-700 border-green-200',
                               Returned:  'bg-yellow-100 text-yellow-700 border-yellow-200',
                               Cancelled: 'bg-red-100 text-red-700 border-red-200',
                             }[status] || 'bg-gray-100 text-gray-700 border-gray-200';
                        %>
                            <tr class="order-row hover:bg-gray-50 transition-colors"
                                data-order-id="<%= order.order_id %>"
                                data-driver-id="<%= order.assigned_driver_id || '' %>"
                                data-shipment-id="<%= order.shipment_id || '' %>">
                                <td class="select-col hidden px-3 py-4">
                                    <input type="checkbox" class="row-checkbox rounded border-gray-300" value="<%= order.order_id %>">
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <div class="text-sm font-bold text-blue-600">ORD-<%= order.order_id %></div>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900 font-medium"><%= order.receiptnum || t.n_a %></div>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-700" dir="ltr"><%= order.phone %></div>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <% if (order.merchant_name && order.merchant_partner_id) { %>
                                        <a href="/partners/<%= order.merchant_partner_id %>" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-sm font-medium bg-purple-50 text-purple-700 border border-purple-100 hover:bg-purple-100">
                                            <i class="ph ph-storefront"></i> <%= order.merchant_name %>
                                        </a>
                                    <% } else { %>
                                        <span class="text-sm text-gray-400 italic"><%= t.unassigned %></span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <% if (order.driver_name && order.assigned_driver_id) { %>
                                        <a href="/partners/<%= order.assigned_driver_id %>" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-sm font-medium bg-orange-50 text-orange-700 border border-orange-100 hover:bg-orange-100">
                                            <i class="ph ph-steering-wheel"></i> <%= order.driver_name %>
                                        </a>
                                    <% } else { %>
                                        <span class="text-sm text-gray-400 italic"><%= t.unassigned %></span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <% if (order.shipment_id) { %>
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-sm font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                            <i class="ph ph-package"></i> #<%= order.shipment_id %>
                                        </span>
                                    <% } else { %>
                                        <span class="text-sm text-gray-400 italic"><%= t.unassigned %></span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold border <%= statusClass %>">
                                        <%= status %>
                                    </span>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap text-end text-sm font-medium">
                                    <button type="button" onclick="openOrderModal(<%= order.order_id %>)" class="text-blue-600 hover:text-blue-900 bg-blue-50 px-3 py-1.5 rounded-md hover:bg-blue-100 transition-colors font-bold inline-flex items-center gap-1">
                                        <i class="ph ph-pencil-simple"></i> Edit
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr id="no-results-row">
                            <td colspan="9" class="px-6 py-12 text-center text-gray-500">
                                <i class="ph ph-package text-4xl mb-2 text-gray-300"></i>
                                <p><%= t.no_orders_found %></p>
                            </td>
                        </tr>
                    <% } %>

                </tbody>
            </table>
        </div>

        <div id="search-empty-state" class="hidden px-6 py-12 text-center text-gray-500">
            <i class="ph ph-magnifying-glass text-4xl mb-2 text-gray-300"></i>
            <p><%= t.no_orders_match %></p>
        </div>
    </div>

</div>

<script>
    document.getElementById('orderSearch').addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        const rows = document.querySelectorAll('#orderTableBody tr.order-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const rowText = row.textContent.toLowerCase();

            if (rowText.includes(searchTerm)) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        const emptyState = document.getElementById('search-empty-state');
        if (visibleCount === 0 && rows.length > 0) {
            emptyState.classList.remove('hidden');
        } else {
            emptyState.classList.add('hidden');
        }
    });
</script>

<script>
    window.ORDERS_BY_ID = <%- JSON.stringify(
        Object.fromEntries((orders || []).map(o => [o.order_id, o]))
    ).replace(/<\//g, '<\\/') %>;
</script>

<script>
(function () {
  const bar = document.getElementById('selectModeBar');
  const label = document.getElementById('selectModeLabel');
  const shipmentPicker = document.getElementById('shipmentPicker');
  const driverPicker = document.getElementById('driverPicker');
  const shipmentSelect = document.getElementById('shipmentSelect');
  const driverSelect = document.getElementById('driverSelect');
  const confirmBtn = document.getElementById('confirmAssignBtn');
  const cancelBtn = document.getElementById('cancelAssignBtn');
  const selectAllBox = document.getElementById('selectAllBox');
  const selectedCountEl = document.getElementById('selectedCount');
  const selectCols = document.querySelectorAll('.select-col');
  const rowCheckboxes = () => document.querySelectorAll('#orderTableBody .row-checkbox');

  let mode = null; // 'shipment' | 'driver' | null

  function setMode(next) {
    mode = next;
    if (!next) {
      bar.classList.add('hidden');
      selectCols.forEach(c => c.classList.add('hidden'));
      rowCheckboxes().forEach(c => { c.checked = false; });
      selectAllBox.checked = false;
      updateCount();
      return;
    }
    bar.classList.remove('hidden');
    selectCols.forEach(c => c.classList.remove('hidden'));
    if (next === 'shipment') {
      label.textContent = 'Assigning shipment';
      shipmentPicker.classList.remove('hidden');
      driverPicker.classList.add('hidden');
    } else {
      label.textContent = 'Assigning driver';
      driverPicker.classList.remove('hidden');
      shipmentPicker.classList.add('hidden');
    }
    updateCount();
  }

  function updateCount() {
    const selected = Array.from(rowCheckboxes()).filter(c => c.checked);
    selectedCountEl.textContent = selected.length;
    const targetID = mode === 'shipment' ? shipmentSelect.value : driverSelect.value;
    confirmBtn.disabled = selected.length === 0 || !targetID;
  }

  document.getElementById('assignShipmentBtn').addEventListener('click', () => setMode('shipment'));
  document.getElementById('assignDriverBtn').addEventListener('click', () => setMode('driver'));
  cancelBtn.addEventListener('click', () => setMode(null));

  selectAllBox.addEventListener('change', function () {
    rowCheckboxes().forEach(cb => {
      const row = cb.closest('tr');
      if (row.style.display === 'none') return; // skip hidden-by-search rows
      cb.checked = this.checked;
    });
    updateCount();
  });

  document.getElementById('orderTableBody').addEventListener('change', function (e) {
    if (e.target.classList.contains('row-checkbox')) updateCount();
  });

  shipmentSelect.addEventListener('change', updateCount);
  driverSelect.addEventListener('change', updateCount);

  confirmBtn.addEventListener('click', function () {
    const selected = Array.from(rowCheckboxes()).filter(c => c.checked);
    if (selected.length === 0) return;
    const targetID = mode === 'shipment' ? shipmentSelect.value : driverSelect.value;
    if (!targetID) return;

    // Confirm reassignment if any selected order already has a value.
    const reassigning = selected.filter(cb => {
      const row = cb.closest('tr');
      const existing = mode === 'shipment'
        ? row.getAttribute('data-shipment-id')
        : row.getAttribute('data-driver-id');
      return existing && existing !== '' && existing !== targetID;
    });
    if (reassigning.length > 0) {
      const ok = window.confirm(
        reassigning.length + ' of the selected orders already have a ' + mode +
        '. Are you sure you want to change ' + (reassigning.length === 1 ? 'its' : 'their') + ' ' + mode + '?'
      );
      if (!ok) return;
    }

    // Build and submit a hidden form (lets the browser do the POST + redirect).
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = mode === 'shipment' ? '/orders/assign/shipment' : '/orders/assign/driver';
    selected.forEach(cb => {
      const inp = document.createElement('input');
      inp.type = 'hidden';
      inp.name = 'order_ids';
      inp.value = cb.value;
      form.appendChild(inp);
    });
    const targetInp = document.createElement('input');
    targetInp.type = 'hidden';
    targetInp.name = mode === 'shipment' ? 'shipment_id' : 'driver_partner_id';
    targetInp.value = targetID;
    form.appendChild(targetInp);
    document.body.appendChild(form);
    form.submit();
  });
})();
</script>

<%- include('partials/edit_order_modal', { returnPath: '/orders' }) %>

<%- include('partials/footer') %>
