<%- include('partials/header') %>

<div class="max-w-3xl mx-auto mt-8 px-4 sm:px-6 lg:px-8">

    <div class="mb-8">
        <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <i class="ph ph-wallet text-blue-600"></i> <%= t.step_4_title %>
        </h1>
        <p class="mt-2 text-sm text-gray-500 font-medium"><%= t.step_4_title %></p>

        <div class="w-full bg-gray-200 rounded-full h-2.5 mt-4">
            <div class="bg-blue-600 h-2.5 rounded-full" style="width: 100%"></div>
        </div>
    </div>

    <% const orderValue = Number((locals.order && order.order_value) || 0); %>
    <% const hasCompany = !!(locals.order && order.company_partner_id); %>
    <% const hasDriver = !!(locals.order && order.assigned_driver_id); %>
    <% const existingProfit = locals.order && order.profit != null ? Number(order.profit) : 5; %>
    <% const existingDriverComm = locals.order && order.driver_commission != null ? Number(order.driver_commission) : 0; %>
    <% const existingCompanyComm = locals.order && order.company_commission != null ? Number(order.company_commission) : 0; %>
    <% const senderName = (locals.sender && sender.name) || (locals.order && order.merchant_name) || ""; %>

    <div class="bg-gradient-to-br from-blue-50 to-purple-50 border border-blue-100 rounded-2xl p-5 mb-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <p class="text-xs font-bold text-blue-700 uppercase tracking-wider"><%= t.order_value_locked %></p>
                <p class="text-3xl font-bold text-gray-900 mt-1" dir="ltr">
                    <%= orderValue.toLocaleString() %> <span class="text-base font-normal text-gray-500"><%= t.currency %></span>
                </p>
            </div>
            <div class="text-sm text-gray-700 space-y-1">
                <% if (senderName) { %><div><i class="ph ph-storefront text-purple-600"></i> <%= senderName %> <span class="text-xs text-gray-500">(<%= t.sender %>)</span></div><% } %>
                <% if (locals.order && order.driver_name)   { %><div><i class="ph ph-steering-wheel text-orange-600"></i> <%= order.driver_name %></div><% } %>
                <% if (locals.order && order.company_name)  { %><div><i class="ph ph-buildings text-indigo-600"></i> <%= order.company_name %></div><% } %>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
        <form action="/orders/<%= orderID %>/commissions" method="POST" class="space-y-6">

            <div>
                <label for="profit" class="block text-sm font-bold text-gray-700 mb-2">
                    <%= t.profit %>
                    <span class="text-gray-400 font-normal">— <%= t.owner_profit_auto %></span>
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                        <i class="ph ph-trend-up text-lg text-green-600"></i>
                    </div>
                    <input type="number" step="0.01" min="0" id="profit" name="profit" value="<%= existingProfit %>" required dir="ltr"
                           class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-12 transition-all text-start">
                    <div class="absolute inset-y-0 end-0 flex items-center pe-4 pointer-events-none text-gray-500 font-bold text-sm"><%= t.currency %></div>
                </div>
                <p class="mt-1 text-xs text-gray-500"><%= t.profit_default_note %></p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2"><%= t.driver_commission_label || t.driver_commission %></label>
                    <div class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 flex items-center gap-2">
                        <i class="ph ph-steering-wheel text-lg text-orange-500"></i>
                        <span class="text-gray-700 font-medium" dir="ltr">
                            <% if (hasDriver) { %>
                                <%= existingDriverComm.toLocaleString() %> <%= t.currency %>
                            <% } else { %>
                                <span class="text-gray-400"><%= t.driver_commission_based_on_driver %></span>
                            <% } %>
                        </span>
                    </div>
                </div>

                <div>
                    <label for="company_commission" class="block text-sm font-bold text-gray-700 mb-2">
                        <%= t.company_commission %>
                        <% if (!hasCompany) { %><span class="text-gray-400 font-normal">— <%= t.no_company_assigned %></span><% } %>
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                            <i class="ph ph-buildings text-lg text-indigo-500"></i>
                        </div>
                        <input type="number" step="0.01" min="0" id="company_commission" name="company_commission" value="<%= existingCompanyComm %>" <%= hasCompany ? '' : 'disabled' %> dir="ltr"
                               class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-12 transition-all text-start disabled:bg-gray-100 disabled:text-gray-400">
                        <div class="absolute inset-y-0 end-0 flex items-center pe-4 pointer-events-none text-gray-500 font-bold text-sm"><%= t.currency %></div>
                    </div>
                </div>
            </div>

            <div class="bg-purple-50 border border-purple-200 rounded-2xl p-5">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-xs font-bold text-purple-700 uppercase tracking-wider"><%= t.merchant_payout %></p>
                        <p class="text-2xl font-bold mt-1" dir="ltr">
                            <span id="merchant_payout_display" class="text-green-700"><%= (orderValue - existingProfit - existingDriverComm - existingCompanyComm).toLocaleString() %></span>
                            <span class="text-sm font-normal text-gray-500"><%= t.currency %></span>
                        </p>
                        <p class="text-xs text-gray-600 mt-1"><%= t.merchant_payout_desc %></p>
                    </div>
                    <div class="text-3xl text-purple-400"><i class="ph ph-arrow-counter-clockwise"></i></div>
                </div>
            </div>

            <div class="pt-6 mt-6 border-t border-gray-100 flex flex-col sm:flex-row justify-end gap-3">
                <% if (locals.sender && sender.id) { %>
                    <button type="submit" name="next_action" value="chain" id="chainBtn"
                            class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 disabled:bg-gray-300 disabled:cursor-not-allowed">
                        <i class="ph ph-plus-circle text-xl"></i>
                        <%= t.create_another_for_sender %>
                        <% if (sender.name) { %><span class="hidden sm:inline text-purple-200 font-normal">— <%= sender.name %></span><% } %>
                    </button>
                <% } %>
                <button type="submit" name="next_action" value="done" id="completeBtn"
                        class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 disabled:bg-gray-300 disabled:cursor-not-allowed">
                    <i class="ph ph-check-circle text-xl"></i> <%= t.done %>
                </button>
            </div>

        </form>
    </div>
</div>

<script>
    (function() {
        const orderValue = <%= orderValue %>;
        const existingDriverComm = <%= existingDriverComm %>;
        const profitInput = document.getElementById('profit');
        const companyInput = document.getElementById('company_commission');
        const display = document.getElementById('merchant_payout_display');
        const doneBtn = document.getElementById('completeBtn');
        const chainBtn = document.getElementById('chainBtn');

        function recalc() {
            const profit = parseFloat(profitInput.value) || 0;
            const company = (companyInput && !companyInput.disabled) ? (parseFloat(companyInput.value) || 0) : 0;
            const payout = orderValue - profit - existingDriverComm - company;
            display.textContent = payout.toLocaleString(undefined, { maximumFractionDigits: 2 });
            const negative = payout < 0;
            display.classList.toggle('text-red-600', negative);
            display.classList.toggle('text-green-700', !negative);
            doneBtn.disabled = negative;
            if (chainBtn) chainBtn.disabled = negative;
        }

        [profitInput, companyInput].filter(Boolean).forEach(function(el) {
            el.addEventListener('input', recalc);
        });
        recalc();
    })();
</script>

<%- include('partials/footer') %>
