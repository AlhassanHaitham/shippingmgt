<%- include('partials/header') %>

<div class="max-w-3xl mx-auto mt-8 px-4 sm:px-6 lg:px-8">
    
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <i class="ph ph-wallet text-blue-600"></i> <%= t.step_4_title %>
        </h1>
        <p class="mt-2 text-sm text-gray-500 font-medium"><%= t.step_4_title %></p>
        
        <div class="w-full bg-gray-200 rounded-full h-2.5 mt-4">
            <div class="bg-blue-600 h-2.5 rounded-full" style="width: 100%"></div>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
        <form action="/orders/<%= orderID %>/commissions" method="POST" class="space-y-6">
            
            <div>
                <label for="delivery_price" class="block text-sm font-bold text-gray-700 mb-2"><%= t.delivery_price %></label>
                <div class="relative">
                    <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                        <i class="ph ph-money text-lg text-green-600"></i>
                    </div>
                    <input type="number" step="0.01" id="delivery_price" name="delivery_price" placeholder="<%= t.price_placeholder %>" required dir="ltr"
                           class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-4 transition-all text-start">
                    <div class="absolute inset-y-0 end-0 flex items-center pe-4 pointer-events-none text-gray-500 font-bold text-sm">
                        <%= t.currency %>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="driver_commission" class="block text-sm font-bold text-gray-700 mb-2"><%= t.driver_commission %></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                            <i class="ph ph-steering-wheel text-lg"></i>
                        </div>
                        <input type="number" step="0.01" id="driver_commission" name="driver_commission" placeholder="<%= t.price_placeholder %>" required dir="ltr"
                               class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-4 transition-all text-start">
                    </div>
                </div>

                <div>
                    <label for="merchant_commission" class="block text-sm font-bold text-gray-700 mb-2"><%= t.merchant_commission %></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                            <i class="ph ph-storefront text-lg"></i>
                        </div>
                        <input type="number" step="0.01" id="merchant_commission" name="merchant_commission" placeholder="<%= t.price_placeholder %>" required dir="ltr"
                               class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-4 transition-all text-start">
                    </div>
                </div>
            </div>

            <div class="pt-6 mt-6 border-t border-gray-100 flex justify-end">
                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-xl shadow-md hover:shadow-lg transition-all flex items-center gap-2">
                    <i class="ph ph-check-circle text-xl"></i> <%= t.complete_order %>
                </button>
            </div>

        </form>
    </div>
</div>

<%- include('partials/footer') %>