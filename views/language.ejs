<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShipFlow - Select Language</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4 font-sans">

    <div class="bg-white rounded-3xl shadow-xl p-8 sm:p-12 max-w-md w-full text-center border border-gray-100">
        
        <div class="flex items-center justify-center gap-2 mb-6 text-blue-700">
            <i class="ph ph-truck text-6xl"></i>
            <span class="font-bold text-4xl tracking-tight">ShipFlow</span>
        </div>

        <h1 class="text-2xl font-bold text-gray-900 mb-2">Welcome to ShipFlow</h1>
        <p class="text-gray-500 mb-8">Please select your preferred language</p>

        <div class="space-y-4">
            <a href="/set-lang/en" class="flex items-center justify-between w-full p-4 rounded-xl border-2 border-gray-200 hover:border-blue-600 hover:bg-blue-50 transition-all group">
                <span class="text-lg font-bold text-gray-800 group-hover:text-blue-700">English</span>
                <span class="text-sm text-gray-400 font-medium">LTR</span>
            </a>

            <a href="/set-lang/ar" class="flex items-center justify-between w-full p-4 rounded-xl border-2 border-gray-200 hover:border-blue-600 hover:bg-blue-50 transition-all group" dir="rtl">
                <span class="text-lg font-bold text-gray-800 group-hover:text-blue-700">العربية</span>
                <span class="text-sm text-gray-400 font-medium">RTL</span>
            </a>

            <a href="/set-lang/ku" class="flex items-center justify-between w-full p-4 rounded-xl border-2 border-gray-200 hover:border-blue-600 hover:bg-blue-50 transition-all group" dir="rtl">
                <span class="text-lg font-bold text-gray-800 group-hover:text-blue-700">کوردی سۆرانی</span>
                <span class="text-sm text-gray-400 font-medium">RTL</span>
            </a>
        </div>
    </div>

</body>
</html>