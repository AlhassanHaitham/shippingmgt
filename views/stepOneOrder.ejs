<%- include('partials/header') %>

<div class="max-w-3xl mx-auto mt-8 px-4 sm:px-6 lg:px-8">
    
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <i class="ph ph-plus-circle text-blue-600"></i> <%= t.create_new_order %>
        </h1>
        <p class="mt-2 text-sm text-gray-500 font-medium"><%= t.step_1_title %></p>

        <div class="w-full bg-gray-200 rounded-full h-2.5 mt-4">
            <div class="bg-blue-600 h-2.5 rounded-full" style="width: 25%"></div>
        </div>
    </div>

    <% if (locals.sender && sender.name) { %>
        <div class="mb-4 bg-purple-50 border border-purple-200 rounded-2xl px-4 py-3 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2 text-sm">
                <i class="ph ph-storefront text-purple-600 text-lg"></i>
                <span class="font-bold text-purple-900"><%= t.sender %>:</span>
                <span class="text-gray-800"><%= sender.name %></span>
            </div>
            <form action="/orders/new/sender/clear" method="POST" class="m-0">
                <button type="submit" class="text-xs font-medium text-purple-700 hover:text-purple-900 underline">
                    <%= t.change_sender %>
                </button>
            </form>
        </div>
    <% } %>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
        <form action="/orders/new" method="POST" class="space-y-6">
            
            <div>
                <label for="receiptnum" class="block text-sm font-bold text-gray-700 mb-2"><%= t.receipt_num %></label>
                <div class="relative">
                    <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                        <i class="ph ph-receipt text-lg"></i>
                    </div>
                    <input type="text" id="receiptnum" name="receiptnum" placeholder="<%= t.receipt_placeholder %>"
                           class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-4 transition-all">
                </div>
            </div>

            <div>
                <label for="order_value" class="block text-sm font-bold text-gray-700 mb-2">
                    <%= t.order_value %>
                    <span class="text-gray-400 font-normal">— <%= t.order_value_desc %></span>
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                        <i class="ph ph-money text-lg text-green-600"></i>
                    </div>
                    <input type="number" step="0.01" min="0" id="order_value" name="order_value" placeholder="<%= t.order_value_placeholder %>" required dir="ltr"
                           class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-12 transition-all text-start">
                    <div class="absolute inset-y-0 end-0 flex items-center pe-4 pointer-events-none text-gray-500 font-bold text-sm">
                        <%= t.currency %>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="phone" class="block text-sm font-bold text-gray-700 mb-2"><%= t.primary_phone %></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                            <i class="ph ph-phone text-lg"></i>
                        </div>
                        <input type="tel" id="phone" name="phone" placeholder="<%= t.phone_placeholder %>" required dir="ltr"
                               class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-4 transition-all text-start">
                    </div>
                </div>

                <div>
                    <label for="second_phone" class="block text-sm font-bold text-gray-700 mb-2"><%= t.secondary_phone %></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none text-gray-400">
                            <i class="ph ph-phone-plus text-lg"></i>
                        </div>
                        <input type="tel" id="second_phone" name="second_phone" placeholder="<%= t.phone_placeholder %>" dir="ltr"
                               class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-4 transition-all text-start">
                    </div>
                </div>
            </div>

            <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 flex items-start gap-3">
                <div class="flex items-center h-6">
                    <input id="retrieve" name="retrieve" type="checkbox" value="1" 
                           class="w-5 h-5 text-blue-600 bg-white border-gray-300 rounded focus:ring-blue-500 focus:ring-2 cursor-pointer">
                </div>
                <div>
                    <label for="retrieve" class="font-bold text-blue-900 cursor-pointer"><%= t.is_retrieve %></label>
                    <p class="text-sm text-blue-700 mt-0.5"><%= t.retrieve_desc %></p>
                </div>
            </div>

            <div>
                <label for="notes" class="block text-sm font-bold text-gray-700 mb-2"><%= t.order_notes %></label>
                <div class="relative">
                    <div class="absolute top-3 start-0 flex items-start ps-3 pointer-events-none text-gray-400">
                        <i class="ph ph-note-pencil text-lg"></i>
                    </div>
                    <textarea id="notes" name="notes" rows="3" placeholder="<%= t.notes_placeholder %>"
                              class="block w-full rounded-xl border-gray-300 bg-gray-50 border focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 ps-10 pe-4 transition-all resize-none"></textarea>
                </div>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-end">
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all flex items-center gap-2">
                    <%= t.next_location %> <i class="ph ph-arrow-right rtl:hidden"></i><i class="ph ph-arrow-left hidden rtl:block"></i>
                </button>
            </div>

        </form>
    </div>
</div>

<%- include('partials/footer') %>