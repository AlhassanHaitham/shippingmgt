<div id="locationModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-[100]">
    <div class="bg-white w-full max-w-md rounded-3xl p-6 shadow-2xl">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-bold text-gray-900 flex items-center gap-2">
                <i class="ph ph-map-pin-plus text-blue-600"></i> Add New Location
            </h3>
            <button type="button" onclick="document.getElementById('locationModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-700 text-2xl leading-none">
                <i class="ph ph-x"></i>
            </button>
        </div>

        <form action="/locations/new" method="POST" class="space-y-4">
            <input type="hidden" name="return_to" value="<%= locals.returnPath || '/' %>">

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Location Name</label>
                <input type="text" name="location_name" required maxlength="30" placeholder="e.g. Main Warehouse"
                       class="block w-full rounded-xl border border-gray-300 bg-gray-50 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 px-4 transition-all">
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Type <span class="text-gray-400 font-normal">(optional)</span></label>
                <input type="text" name="type" maxlength="30" placeholder="warehouse / store / branch"
                       class="block w-full rounded-xl border border-gray-300 bg-gray-50 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 px-4 transition-all">
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Owner Partner <span class="text-gray-400 font-normal">(optional)</span></label>
                <select name="partner_id"
                        class="block w-full rounded-xl border border-gray-300 bg-gray-50 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-3 px-4 transition-all appearance-none">
                    <option value="">&mdash; No partner &mdash;</option>
                    <% if (locals.partners && partners.length > 0) { %>
                        <% partners.forEach(function(p) { %>
                            <option value="<%= p.partner_id %>">
                                <%= p.partner_name || ('Partner #' + p.partner_id) %><% if (p.partner_type) { %> (<%= p.partner_type %>)<% } %>
                            </option>
                        <% }); %>
                    <% } %>
                </select>
            </div>

            <div class="flex gap-2 pt-4">
                <button type="button" onclick="document.getElementById('locationModal').classList.add('hidden')" class="flex-1 py-3 rounded-xl font-bold text-gray-600 hover:bg-gray-100 transition-colors">Cancel</button>
                <button type="submit" class="flex-1 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold transition-colors flex items-center justify-center gap-2">
                    <i class="ph ph-plus-circle"></i> Add Location
                </button>
            </div>
        </form>
    </div>
</div>
