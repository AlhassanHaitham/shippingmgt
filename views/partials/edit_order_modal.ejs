<div id="orderModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-[100] overflow-y-auto">
    <div class="bg-white w-full max-w-2xl rounded-3xl p-6 shadow-2xl my-8">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-bold text-gray-900 flex items-center gap-2">
                <i class="ph ph-pencil-simple text-blue-600"></i> Edit Order <span id="modal-order-id" class="text-blue-600 font-mono"></span>
            </h3>
            <button type="button" onclick="document.getElementById('orderModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-700 text-2xl leading-none">
                <i class="ph ph-x"></i>
            </button>
        </div>

        <form id="orderEditForm" method="POST" class="space-y-4">
            <input type="hidden" name="_method" value="PUT">
            <input type="hidden" name="return_to" value="<%= locals.returnPath || '/orders' %>">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Status <span class="text-xs text-gray-500">— delivery posts ledger, return/cancel reverses it</span></label>
                    <select name="status" id="edit_status" class="block w-full rounded-xl border border-gray-300 bg-gray-50 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-2.5 px-3 transition-all appearance-none">
                        <option value="Pending">Pending</option>
                        <option value="Delivered">Delivered</option>
                        <option value="Returned">Returned</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Receipt #</label>
                    <input type="number" name="receiptnum" id="edit_receiptnum" class="block w-full rounded-xl border border-gray-300 bg-gray-50 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-2.5 px-3 transition-all">
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Primary Phone</label>
                    <input type="tel" name="phone" id="edit_phone" dir="ltr" class="block w-full rounded-xl border border-gray-300 bg-gray-50 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-2.5 px-3 transition-all text-start">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Secondary Phone</label>
                    <input type="tel" name="second_phone" id="edit_second_phone" dir="ltr" class="block w-full rounded-xl border border-gray-300 bg-gray-50 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-2.5 px-3 transition-all text-start">
                </div>
            </div>

            <div class="flex items-center gap-2 bg-blue-50 border border-blue-100 rounded-xl px-3 py-2">
                <input type="checkbox" name="retrieve" id="edit_retrieve" value="1" class="w-4 h-4 text-blue-600 rounded">
                <label for="edit_retrieve" class="text-sm font-medium text-blue-900">Retrieve order (exchange)</label>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1.5">Notes</label>
                <textarea name="notes" id="edit_notes" rows="2" class="block w-full rounded-xl border border-gray-300 bg-gray-50 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 text-gray-900 py-2.5 px-3 transition-all resize-none"></textarea>
            </div>

            <hr class="border-gray-200">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Merchant</label>
                    <select name="merchant_partner_id" id="edit_merchant" class="block w-full rounded-xl border border-gray-300 bg-gray-50 py-2.5 px-3 appearance-none">
                        <option value="">— None —</option>
                        <% if (locals.merchants) merchants.forEach(function(m){ %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Driver</label>
                    <select name="driver_partner_id" id="edit_driver" class="block w-full rounded-xl border border-gray-300 bg-gray-50 py-2.5 px-3 appearance-none">
                        <option value="">— None —</option>
                        <% if (locals.drivers) drivers.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }); %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Company <span class="text-gray-400 font-normal">(optional)</span></label>
                    <select name="company_partner_id" id="edit_company" class="block w-full rounded-xl border border-gray-300 bg-gray-50 py-2.5 px-3 appearance-none">
                        <option value="">— None —</option>
                        <% if (locals.companies) companies.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Shipment</label>
                    <select name="shippment_id" id="edit_shipment" class="block w-full rounded-xl border border-gray-300 bg-gray-50 py-2.5 px-3 appearance-none">
                        <option value="">— None —</option>
                        <% if (locals.shipments) shipments.forEach(function(s){ %><option value="<%= s.id %>"><%= s.name %></option><% }); %>
                    </select>
                </div>
            </div>

            <hr class="border-gray-200">

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Order Value</label>
                    <input type="number" step="0.01" min="0" name="order_value" id="edit_order_value" dir="ltr" class="block w-full rounded-lg border border-gray-300 bg-gray-50 py-2 px-2 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Profit</label>
                    <input type="number" step="0.01" min="0" name="profit" id="edit_profit" dir="ltr" class="block w-full rounded-lg border border-gray-300 bg-gray-50 py-2 px-2 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Driver Comm.</label>
                    <input type="number" step="0.01" min="0" name="driver_commission" id="edit_driver_commission" dir="ltr" class="block w-full rounded-lg border border-gray-300 bg-gray-50 py-2 px-2 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Company Comm.</label>
                    <input type="number" step="0.01" min="0" name="company_commission" id="edit_company_commission" dir="ltr" class="block w-full rounded-lg border border-gray-300 bg-gray-50 py-2 px-2 text-sm">
                </div>
            </div>
            <p class="text-xs text-gray-500"><i class="ph ph-info"></i> Merchant payout = order_value − profit − driver − company, posted automatically when status flips to Delivered.</p>

            <div class="flex gap-2 pt-4">
                <button type="button" onclick="document.getElementById('orderModal').classList.add('hidden')" class="flex-1 py-3 rounded-xl font-bold text-gray-600 hover:bg-gray-100 transition-colors">Cancel</button>
                <button type="submit" class="flex-1 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold transition-colors flex items-center justify-center gap-2">
                    <i class="ph ph-floppy-disk"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    window.openOrderModal = function(orderId) {
        const o = (window.ORDERS_BY_ID || {})[orderId];
        if (!o) return;
        document.getElementById('modal-order-id').textContent = '#' + orderId;
        document.getElementById('orderEditForm').action = '/orders/update/' + orderId;
        document.getElementById('edit_status').value = o.status || 'Pending';
        document.getElementById('edit_receiptnum').value = o.receiptnum == null ? '' : o.receiptnum;
        document.getElementById('edit_phone').value = o.phone || '';
        document.getElementById('edit_second_phone').value = o.second_phone || '';
        document.getElementById('edit_retrieve').checked = !!(o.retrieve == 1 || o.retrieve === true);
        document.getElementById('edit_notes').value = o.notes || '';
        document.getElementById('edit_merchant').value = o.merchant_partner_id || '';
        document.getElementById('edit_driver').value = o.assigned_driver_id || '';
        document.getElementById('edit_company').value = o.company_partner_id || '';
        document.getElementById('edit_shipment').value = o.shipment_id || '';
        document.getElementById('edit_order_value').value = o.order_value == null ? '' : o.order_value;
        document.getElementById('edit_profit').value = o.profit == null ? '' : o.profit;
        document.getElementById('edit_driver_commission').value = o.driver_commission == null ? '' : o.driver_commission;
        document.getElementById('edit_company_commission').value = o.company_commission == null ? '' : o.company_commission;
        document.getElementById('orderModal').classList.remove('hidden');
    };
</script>
