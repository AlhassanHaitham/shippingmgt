# Copy this file to .env and fill in real values. Never commit the real .env.

# --- MySQL ---
MYSQL_HOST='127.0.0.1'
MYSQL_USER='root'
MYSQL_PASSWORD=''
MYSQL_DATABASE='shippingmgt'

# --- Admin bootstrap user ---
ADMIN_USERNAME='admin'
ADMIN_PASSWORD='change-me'

# --- Session ---
SESSION_SECRET='change-me-to-a-long-random-string'

# --- OpenRouter (AI support chat) ---
# Create a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=''
# Default is a free model; switch to google/gemini-2.5-flash or openai/gpt-4o-mini for
# stronger Arabic/Kurdish (those need OpenRouter credits).
OPENROUTER_MODEL='meta-llama/llama-3.3-70b-instruct:free'
# 'true' enables live web grounding + source citations (needs a few $ of OpenRouter credits).
OPENROUTER_WEB_SEARCH='false'
